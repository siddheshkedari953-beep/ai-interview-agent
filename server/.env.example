PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_interview
JWT_SECRET=change-this-to-any-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# ---- AI (free). Option A: Groq free tier (get key at https://console.groq.com) ----
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=paste_your_groq_key_here
AI_MODEL=llama-3.3-70b-versatile
# ---- Option B: Ollama, fully local (no key). Uncomment these and comment Option A ----
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.2

# ---- Razorpay TEST keys (optional). Leave empty => built-in mock payment ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
